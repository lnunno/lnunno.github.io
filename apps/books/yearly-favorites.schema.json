{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/goodreads2/yearly-favorites.schema.json",
  "title": "Yearly favorites lists",
  "description": "Versioned yearly-favorites rankings linked to IDs in the generated bookshelf data.",
  "$comment": "JSON Schema cannot require ranks to be sequential or verify that referenced book IDs exist in highlighted-books.json; those invariants require application-level validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "lists"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "lists": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/yearlyFavoritesList"
      }
    }
  },
  "definitions": {
    "bookId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "rank": {
      "type": "integer",
      "minimum": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "singleBookIdList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/bookId"
      }
    },
    "groupBookIdList": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/bookId"
      }
    },
    "bookRanking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "label",
        "kind",
        "bookIds"
      ],
      "properties": {
        "rank": {
          "$ref": "#/definitions/rank"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "kind": {
          "const": "book"
        },
        "bookIds": {
          "$ref": "#/definitions/singleBookIdList"
        }
      }
    },
    "multiBookRanking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "label",
        "kind",
        "bookIds"
      ],
      "properties": {
        "rank": {
          "$ref": "#/definitions/rank"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "kind": {
          "enum": [
            "group",
            "series"
          ]
        },
        "bookIds": {
          "$ref": "#/definitions/groupBookIdList"
        }
      }
    },
    "graphicSeriesRanking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "label",
        "kind",
        "representativeBookId"
      ],
      "properties": {
        "rank": {
          "$ref": "#/definitions/rank"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "kind": {
          "const": "graphic-series"
        },
        "representativeBookId": {
          "description": "A representative cover for a manga or comics series; this is not an exhaustive volume reference.",
          "$ref": "#/definitions/bookId"
        }
      }
    },
    "ranking": {
      "oneOf": [
        {
          "$ref": "#/definitions/bookRanking"
        },
        {
          "$ref": "#/definitions/multiBookRanking"
        },
        {
          "$ref": "#/definitions/graphicSeriesRanking"
        }
      ]
    },
    "yearlyFavoritesList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "title",
        "rankings"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 9999
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "rankings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/ranking"
          }
        }
      }
    }
  }
}
